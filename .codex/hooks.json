{
  "description": "Project context and generated contract protection hooks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session_start.mjs\"",
            "statusMessage": "Loading package context",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/protect_generated_openapi.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
